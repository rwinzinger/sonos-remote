// Template for secrets.h — this file IS committed, secrets.h is NOT.
//
// Setup:  cp secrets.h.example secrets.h   then fill in real values.
//
// Never put real credentials in this file. `.gitignore` covers secrets.h at any depth,
// and explicitly un-ignores this .example so the template stays in the repo.

#pragma once

// --- WiFi -------------------------------------------------------------------------
// The board's radio is 2.4 GHz only. A 5 GHz-only SSID will never connect, and the
// failure looks identical to a wrong password.
#define WIFI_SSID  "your-2.4GHz-ssid"
#define WIFI_PASS  "your-wifi-password"

// --- Sonos ------------------------------------------------------------------------
// OPTIONAL. Leave empty to discover the coordinator at runtime via SSDP +
// ZoneGroupTopology, which is the recommended path — a hardcoded IP breaks silently when
// DHCP changes it or when Sonos reassigns the group coordinator.
//
// Set it only to pin a known player while debugging, e.g. "192.168.178.42".
#define SONOS_COORDINATOR_IP  ""

// Room whose group volume the knob controls. Used to pick the right coordinator from the
// topology. Leave empty to fall back to the first group found.
#define SONOS_TARGET_ROOM  ""

// --- Screen 3 "Radio" scene --------------------------------------------------------
// Station the Radio mode starts on Main. Leave EMPTY to make Radio a grouping-only
// scene (Main alone, no source change). Your Sonos favourites contain only Sonos Radio
// promos, so the station is configured here rather than looked up by name.
#define SONOS_RADIO_URI  ""
